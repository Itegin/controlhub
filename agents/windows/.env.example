SERVER_IP=192.168.0.28
SERVER_PORT=8000
AGENT_TOKEN=change-me
# Full SoundVolumeView "Command-Line Friendly ID" (DriverName\Device\Name\Direction),
# not the bare device Name -- a bare Name like "Динамики" can collide with an
# unrelated device's own subunits/channels in SoundVolumeView's listing (e.g.
# a capture-side "Динамики" subunit under a fifine Microphone shows up next to
# the actual Realtek render device also named "Динамики"). Get this string by
# running SoundVolumeView, exporting the device list, and copying the exact
# "Command-Line Friendly ID" column value -- don't hand-abbreviate it.
OUTPUT_DEVICE_PRIMARY="Realtek(R) Audio\Device\Динамики\Render"
OUTPUT_DEVICE_SECONDARY="NVIDIA High Definition Audio\Device\M24X4\Render"
# VPN_PATH: absolute path to your VPN client executable. VPN_PROCESS_NAME:
# exact process name as shown in Task Manager (case doesn't matter, matched
# case-insensitively).
VPN_PROCESS_NAME=openvpn-gui.exe
VPN_PATH=C:\Program Files\OpenVPN\bin\openvpn-gui.exe
